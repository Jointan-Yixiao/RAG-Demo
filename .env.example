# Copy to .env in the project root and fill in. Never commit or ship .env.
# Only the existing OpenAI-compatible adapter reads this file, and only with --execute.
# An environment variable of the same name takes precedence over this file.
DEEPSEEK_API_KEY=

# Local directory of the pinned BAAI/bge-reranker-v2-m3 files
# (written by: python scripts/_rebuild_runtime.py models --download --bge-dir models/bge-reranker-v2-m3).
# This is read from the process environment, not from .env: set it in the shell.
# RAG_BGE_MODEL_DIR=
