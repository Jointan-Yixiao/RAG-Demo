{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG-Demo Chunk v3 — canonical body + visual_description",
  "description": "Default production table after description-only cutover. Historical chunk_id values may contain ::figure:: while kind is visual_description (ID compatibility, not type semantics). chunk-v2.schema.json remains the historical contract.",
  "type": "object",
  "required": [
    "schema_version",
    "chunk_id",
    "kind",
    "seq",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "chunk_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "kind": {
      "enum": [
        "text",
        "visual_description"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "retrieval_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "E10 text_input used to encode the description vector, or the E16 split span of that input. Not ordinary body text."
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "text"
          }
        }
      },
      "then": {
        "required": [
          "text"
        ],
        "not": {
          "required": [
            "retrieval_text"
          ]
        },
        "properties": {
          "metadata": {
            "$ref": "#/$defs/textMetadata"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "visual_description"
          }
        }
      },
      "then": {
        "required": [
          "text",
          "retrieval_text"
        ],
        "properties": {
          "metadata": {
            "$ref": "#/$defs/visualDescriptionMetadata"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "pattern": "::e16span::"
          }
        },
        "required": [
          "chunk_id"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "required": [
              "origin_chunk_id",
              "parent_chunk_id",
              "e16_span"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$",
      "description": "项目根目录相对路径，使用 /，不含驱动器、URL、反斜杠或 .. 路径段。"
    },
    "lineageChunkId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "originChunkId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:(?!::e16span::)\\S)+$",
      "description": "Archived unsplit root id. Must not itself be a split-child ::e16span:: id."
    },
    "e16Span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "char_start",
        "char_end",
        "envelope_tokens"
      ],
      "properties": {
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 1
        },
        "envelope_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1500
        }
      }
    },
    "textMetadata": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "document_title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_path": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "section_path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "origin_chunk_id": {
          "$ref": "#/$defs/originChunkId"
        },
        "parent_chunk_id": {
          "$ref": "#/$defs/lineageChunkId"
        },
        "e16_span": {
          "$ref": "#/$defs/e16Span"
        }
      },
      "required": [
        "document_id",
        "document_title",
        "source_path",
        "source_url",
        "section_path"
      ],
      "dependentRequired": {
        "origin_chunk_id": [
          "parent_chunk_id",
          "e16_span"
        ],
        "parent_chunk_id": [
          "origin_chunk_id",
          "e16_span"
        ],
        "e16_span": [
          "origin_chunk_id",
          "parent_chunk_id"
        ]
      },
      "additionalProperties": false
    },
    "visualDescriptionMetadata": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "document_title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_path": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "section_path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "image_path": {
          "$ref": "#/$defs/repoRelativePath",
          "description": "Evidence display path. Runtime must not load the PNG for ranking."
        },
        "visual_type": {
          "enum": [
            "figure",
            "table"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "prev_text_chunk_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "next_text_chunk_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "caption_chunk_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "relation_kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "association_provenance": {
          "type": "object"
        },
        "text_is_image_generated": {
          "type": "boolean",
          "description": "true when associated_text is reviewed image-observation; false when source-backed."
        },
        "origin_chunk_id": {
          "$ref": "#/$defs/originChunkId"
        },
        "parent_chunk_id": {
          "$ref": "#/$defs/lineageChunkId"
        },
        "e16_span": {
          "$ref": "#/$defs/e16Span"
        }
      },
      "required": [
        "document_id",
        "document_title",
        "source_path",
        "source_url",
        "section_path",
        "image_path",
        "visual_type",
        "label",
        "prev_text_chunk_id",
        "next_text_chunk_id",
        "caption_chunk_ids",
        "relation_kind",
        "association_provenance",
        "text_is_image_generated"
      ],
      "dependentRequired": {
        "origin_chunk_id": [
          "parent_chunk_id",
          "e16_span"
        ],
        "parent_chunk_id": [
          "origin_chunk_id",
          "e16_span"
        ],
        "e16_span": [
          "origin_chunk_id",
          "parent_chunk_id"
        ]
      },
      "additionalProperties": false
    }
  }
}
